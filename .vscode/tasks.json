{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CareFlow: Start Backend (FastAPI)",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "CareFlow: Start Frontend (Next.js)",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "CareFlow: Seed Database",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && python -m app.seed",
      "problemMatcher": []
    },
    {
      "label": "CareFlow: Run Tests (pytest)",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && pytest -v",
      "problemMatcher": []
    }
  ]
}
