output "site_url" { value = "https://${local.site_host}" }
output "public_ip" { value = aws_eip.web.public_ip }
output "instance_id" { value = var.enable_instance ? aws_instance.web[0].id : null }
output "ecr_backend" { value = aws_ecr_repository.repo["backend"].repository_url }
output "ecr_frontend" { value = aws_ecr_repository.repo["frontend"].repository_url }
output "records_bucket" { value = local.bucket_records }
output "rds_endpoint" { value = aws_db_instance.main.address }
output "sns_topic" { value = aws_sns_topic.alerts.arn }
output "cognito_pool_id" { value = aws_cognito_user_pool.main.id }
output "secrets" { value = [aws_secretsmanager_secret.db.name, aws_secretsmanager_secret.jwt.name, aws_secretsmanager_secret.seed.name] }
